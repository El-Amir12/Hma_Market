{
    # Configuration globale pour FrankenPHP
    frankenphp
}

:{$PORT:80} {
    # Racine du site pointant vers le dossier public de Symfony
    root * /app/public

    # Activation de la compression pour les performances
    encode zstd br gzip

    # Exécution des scripts PHP via FrankenPHP
    php_server
}