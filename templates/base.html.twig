                                         alt="{{ app.user.fullName }}" 
                                         class="user-avatar-img"
                                         onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'user-avatar-initials\'>{{ app.user.fullName|first|upper }}</div>';">
                                {% else %}
