{# templates/customer/auth/check_email.html.twig #}
{% extends 'base_customer.html.twig' %}

{% block title %}Email envoyé - HMA Market{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <i class="fas fa-envelope fa-4x text-primary mb-3"></i>
                    <h3 class="fw-bold">Email envoyé !</h3>
                    <p class="text-muted">
                        Un email de réinitialisation vous a été envoyé.<br>
                        Vérifiez votre boîte de réception et vos spams.
                    </p>
                </div>

                <div class="alert alert-info rounded-3">
                    <i class="fas fa-info-circle me-2"></i>
                    Le lien de réinitialisation est valable pendant 1 heure.
                </div>

                <div class="mt-4">
                    <a href="{{ path('customer_login') }}" class="btn btn-primary">
                        <i class="fas fa-arrow-left me-2"></i>Retour à la connexion
                    </a>
                </div>

                <div class="mt-3">
                    <p class="text-muted small">
                        Vous n'avez pas reçu l'email ? 
                        <a href="{{ path('customer_forgot_password') }}" class="text-decoration-none">
                            Renvoyer
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}