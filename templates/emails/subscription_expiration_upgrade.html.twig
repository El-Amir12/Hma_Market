{# templates/emails/subscription_expiration_upgrade.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Rappel d'expiration d'abonnement</title>
</head>
<body style="font-family: Arial, sans-serif; background: #f5f5f5; margin: 0; padding: 20px;">
    <table width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; margin: 0 auto; background: white; border-radius: 10px; overflow: hidden;">
        <tr>
            <td style="background: linear-gradient(135deg, #667eea 0%, #0463f1 100%); padding: 30px; text-align: center;">
                <h1 style="color: white; margin: 0; font-size: 24px;">
                    {% if days_left <= 0 %}⚠️ Abonnement expiré{% else %}🔔 Rappel d'expiration{% endif %}
                </h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 30px;">
                <p>Bonjour <strong>{{ user.fullName }}</strong>,</p>

                <p>
                    Votre entreprise <strong>{{ company.companyName }}</strong> est actuellement
                    sur le plan <strong>{{ current_plan_label }}</strong>.
                </p>

                {% if days_left <= 0 %}
                    <p style="color: #dc2626; font-weight: bold;">
                        ⚠️ Votre abonnement a expiré. Certaines fonctionnalités sont désormais limitées.
                    </p>
                {% elseif days_left <= 3 %}
                    <p style="color: #dc2626; font-weight: bold;">
                        ⚠️ Votre abonnement expire dans <strong>{{ days_left }} jour(s)</strong>.
                    </p>
                {% else %}
                    <p style="color: #f59e0b; font-weight: bold;">
                        🔔 Votre abonnement expire dans <strong>{{ days_left }} jour(s)</strong>.
                    </p>
                {% endif %}

                <div style="background: #f0f9ff; border-left: 4px solid #0463f1; padding: 15px; margin: 20px 0; border-radius: 5px;">
                    <p style="margin: 0;"><strong>💡 {{ upgrade_message }}</strong></p>
                </div>

                {% if benefits is not empty %}
                    <h3 style="color: #1f2937;">Avantages du plan {{ recommended_plan|upper }} :</h3>
                    <ul style="line-height: 1.8;">
                        {% for benefit in benefits %}
                            <li>✅ {{ benefit }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <div style="text-align: center; margin: 30px 0;">
                    <a href="{{ plans_url }}"
                       style="display: inline-block; background: #0463f1; color: white; padding: 12px 30px; text-decoration: none; border-radius: 8px; font-weight: bold;">
                        🚀 Voir les plans et souscrire
                    </a>
                </div>

                <p style="color: #6b7280; font-size: 12px; margin-top: 30px; border-top: 1px solid #e5e7eb; padding-top: 20px;">
                    Une question ? Contactez-nous à
                    <a href="mailto:{{ support_email }}" style="color: #0463f1;">{{ support_email }}</a>
                </p>
            </td>
        </tr>
        <tr>
            <td style="background: #f9fafb; padding: 20px; text-align: center; color: #6b7280; font-size: 12px;">
                © {{ "now"|date('Y') }} {{ app_name }} — Tous droits réservés
            </td>
        </tr>
    </table>
</body>
</html>