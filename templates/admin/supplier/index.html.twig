/* Très petits mobiles < 376px */
@media (max-width: 375.98px) {
    .stat-item,
    .stat-item-full {
        padding: 0.4rem 0.35rem;
        min-height: 52px;
        gap: 0.3rem;
    }
    .stat-icon,
    .stat-item-full .stat-icon {
        width: 26px;
        height: 26px;
        min-width: 26px;
        font-size: 0.65rem;
    }
    .stat-label,
    .stat-item-full .stat-label {
        font-size: 0.45rem;
    }
    .stat-value,
    .stat-item-full .stat-value {
        font-size: 0.85rem;
    }
    .quota-card {
        padding: 0.3rem 0.5rem;
    }
