    }
    .contact-icon {
        width: 20px;
        height: 20px;
        min-width: 20px;
        font-size: 0.6rem;
        margin-right: 0.4rem;
    }
    .email-link {
        max-width: 120px;
        font-size: 0.75rem !important;
    }

    /* Pagination */
    .pagination-sm .page-link {
        padding: 0.2rem 0.4rem !important;
