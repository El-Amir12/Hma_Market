    }
    .stat-icon,
    .stat-item-full .stat-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        font-size: 1rem;
    }
    .stat-label,
    .stat-item-full .stat-label {
        font-size: 0.7rem;
    }
    .stat-value,
    .stat-item-full .stat-value {
        font-size: 1.25rem;
    }
    .quota-card {
        padding: 0.5rem 0.75rem;
    }
    .quota-badge {
        width: 30px;
        height: 30px;
        font-size: 0.85rem;
    }
    .quota-label {
        font-size: 0.65rem;
    }
    .quota-value {
        font-size: 0.95rem;
