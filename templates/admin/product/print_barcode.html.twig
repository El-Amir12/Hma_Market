{# templates/admin/product/print_barcode.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Code-barres - {{ product.name }}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @media print {
            body {
                margin: 0;
                padding: 0;
            }
            .no-print {
                display: none;
            }
            .barcode-container {
                page-break-after: avoid;
                break-inside: avoid;
            }
        }

        body {
            font-family: 'Arial', 'Helvetica', sans-serif;
            background: #f5f5f5;
            padding: 40px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* Style étiquette */
        .barcode-container {
            background: white;
            width: 350px;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            text-align: center;
        }

        /* Version multiple (2x2 pour impression) */
        .barcode-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            max-width: 800px;
            margin: 0 auto;
        }

        .barcode-card {
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            text-align: center;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .barcode-card .product-name {
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 8px;
            color: #333;
            word-break: break-word;
        }

        .barcode-card .barcode-number {
            font-family: 'Courier New', monospace;
            font-size: 18px;
            font-weight: bold;
            letter-spacing: 2px;
            background: #f8f9fa;
            padding: 8px;
            border-radius: 6px;
            margin: 10px 0;
        }

        .barcode-card .price {
            font-size: 14px;
            color: #28a745;
            font-weight: bold;
            margin-top: 8px;
        }

        /* Style code-barres HTML (simulé) */
        .barcode-simulated {
            position: relative;
            padding: 10px 0;
        }

        .barcode-simulated .bars {
            display: flex;
            justify-content: center;
            gap: 2px;
            margin-bottom: 10px;
        }

        .barcode-simulated .bar {
            background: #000;
            width: 2px;
            height: 50px;
        }

        .barcode-simulated .bar.thick {
            width: 4px;
        }

        .barcode-number-large {
            font-family: 'Courier New', monospace;
            font-size: 24px;
            font-weight: bold;
            letter-spacing: 3px;
            margin: 15px 0;
        }

        /* Boutons d'impression */
        .print-actions {
            text-align: center;
            margin-bottom: 30px;
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }

        .print-actions button {
            padding: 10px 20px;
            margin: 0 5px;
            font-size: 14px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-print {
            background: #667eea;
            color: white;
        }

        .btn-print:hover {
            background: #5a67d8;
            transform: translateY(-1px);
        }

        .btn-close {
            background: #6c757d;
            color: white;
        }

        .btn-close:hover {
            background: #5a6268;
        }

        .btn-multiple {
            background: #28a745;
            color: white;
        }

        .btn-multiple:hover {
            background: #218838;
        }

        .options-panel {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: white;
            padding: 15px 25px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            display: flex;
            gap: 15px;
            z-index: 1000;
        }

        @media print {
            .options-panel {
                display: none;
            }
        }

        .product-info {
            margin-top: 15px;
            font-size: 12px;
            color: #666;
        }

        hr {
            margin: 15px 0;
            border: none;
            border-top: 1px solid #eee;
        }
    </style>
</head>
<body>
    <div class="print-actions no-print">
        <button class="btn-print" onclick="window.print()">
            <i class="fas fa-print"></i> Imprimer
        </button>
        <button class="btn-close" onclick="window.close()">
            <i class="fas fa-times"></i> Fermer
        </button>
    </div>

    <div class="options-panel no-print">
        <button class="btn-multiple" id="singleView">
            <i class="fas fa-square"></i> 1 étiquette
        </button>
        <button class="btn-multiple" id="multipleView">
            <i class="fas fa-th"></i> 4 étiquettes
        </button>
        <select id="quantitySelect" class="form-select" style="width: 80px;">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="4">4</option>
            <option value="8">8</option>
            <option value="12">12</option>
        </select>
        <button class="btn-multiple" id="applyQuantity">
            <i class="fas fa-sync-alt"></i> Appliquer
        </button>
    </div>

    <div id="printContent">
        <!-- Contenu chargé dynamiquement -->
    </div>

    <script>
        function generateBarcodeHTML(barcode) {
            // Simulation de code-barres avec des barres
            let bars = '';
            for (let i = 0; i < barcode.length; i++) {
                const code = parseInt(barcode.charCodeAt(i));
                const isThick = code % 2 === 0;
                bars += `<div class="bar ${isThick ? 'thick' : ''}"></div>`;
            }
            return `
                <div class="barcode-simulated">
                    <div class="bars">${bars}</div>
                    <div class="barcode-number-large">${barcode}</div>
                </div>
            `;
        }

        function renderBarcodes(quantity) {
            const productName = "{{ product.name|escape('js') }}";
            const barcode = "{{ product.barcode|escape('js') }}";
            const price = "{{ product.salePrice|price_with_currency(product.hmaService)|escape('js') }}";
            const unit = "{{ product.unit|default('pièce')|escape('js') }}";
            
            let html = '';
            
            if (quantity === 1) {
                html = `
                    <div class="barcode-container">
                        <div class="barcode-simulated">
                            <div class="barcode-number-large">${barcode}</div>
                        </div>
                        <div class="product-name">${productName}</div>
                        <div class="price">${price}</div>
                        <div class="product-info">
                            <small>Unité: ${unit}</small><br>
                            <small>Réf: ${barcode}</small>
                        </div>
                    </div>
                `;
            } else {
                const cols = quantity >= 4 ? 2 : 1;
                const rows = Math.ceil(quantity / cols);
                
                html = `<div class="barcode-grid" style="grid-template-columns: repeat(${cols}, 1fr);">`;
                for (let i = 0; i < quantity; i++) {
                    html += `
                        <div class="barcode-card">
                            <div class="product-name">${productName}</div>
                            <div class="barcode-number">${barcode}</div>
                            <div class="price">${price}</div>
                            <div class="product-info">
                                <small>Unité: ${unit}</small>
                            </div>
                        </div>
                    `;
                }
                html += `</div>`;
            }
            
            document.getElementById('printContent').innerHTML = html;
        }

        document.addEventListener('DOMContentLoaded', function() {
            renderBarcodes(1);
            
            document.getElementById('singleView').addEventListener('click', function() {
                renderBarcodes(1);
            });
            
            document.getElementById('multipleView').addEventListener('click', function() {
                renderBarcodes(4);
            });
            
            document.getElementById('applyQuantity').addEventListener('click', function() {
                const qty = parseInt(document.getElementById('quantitySelect').value);
                renderBarcodes(qty);
            });
        });
    </script>
</body>
</html>