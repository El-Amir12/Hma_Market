{% extends 'base.html.twig' %}

{% block title %}Réceptionner la commande #{{ purchase.purchaseNumber }}{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow border-0">
                <div class="card-header bg-white border-0">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0">
                                    <li class="breadcrumb-item">
                                        <a href="{{ path('admin_purchase_index') }}" class="text-decoration-none">
                                            <i class="fas fa-shopping-bag me-1"></i>
                                            Achats
                                        </a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="{{ path('admin_purchase_show', {'id': purchase.id}) }}" class="text-decoration-none">
                                            Commande #{{ purchase.purchaseNumber }}
                                        </a>
                                    </li>
                                    <li class="breadcrumb-item active" aria-current="page">
                                        Réceptionner
                                    </li>
                                </ol>
                            </nav>
                            <h2 class="mt-2 mb-0 fw-bold">
                                Réceptionner la commande #{{ purchase.purchaseNumber }}
                            </h2>
                            <p class="text-muted mb-0 mt-1">
                                Fournisseur: {{ purchase.supplier.name }}
                            </p>
                        </div>
                        <div class="btn-group">
                            <a href="{{ path('admin_purchase_show', {'id': purchase.id}) }}" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i> Retour
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="card-body">
                    <form method="post" action="{{ path('admin_purchase_receive', {'id': purchase.id}) }}" id="receiveForm">
                        <div class="alert alert-info mb-4">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Information :</strong> Remplissez les informations de réception pour chaque produit.
                            Les stocks seront mis à jour automatiquement après validation.
                        </div>
                        
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead class="table-primary">
                                    <tr>
                                        <th>Produit</th>
                                        <th class="text-center">Quantité commandée</th>
                                        <th class="text-center">Numéro de lot *</th>
                                        <th class="text-center">Date de fabrication</th>
                                        <th class="text-center">Date d'expiration</th>
                                        <th class="text-center">Prix unitaire (FCFA) *</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in purchase.purchaseItems %}
                                        <tr>
                                            <td>
                                                <strong>{{ item.product.name }}</strong>
                                                <br>
                                                <small class="text-muted">{{ item.product.barcode }}</small>
                                                {% if item.product.hasExpiryDate %}
                                                    <br>
                                                    <small class="badge bg-info">
                                                        <i class="fas fa-clock me-1"></i> Périssable
                                                    </small>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-primary">{{ item.quantity }}</span>
                                            </td>
                                            <td class="text-center">
                                                <input type="text" 
                                                       name="items[{{ item.id }}][batch_number]" 
                                                       class="form-control form-control-sm text-center"
                                                       value="{{ item.batchNumber|default(generate_batch_number()) }}"
                                                       required>
                                            </td>
                                            <td class="text-center">
                                                {% if item.product.hasExpiryDate %}
                                                    <input type="date" 
                                                           name="items[{{ item.id }}][manufacturing_date]" 
                                                           class="form-control form-control-sm"
                                                           value="{{ item.manufacturingDate ? item.manufacturingDate|date('Y-m-d') : '' }}">
                                                {% else %}
                                                    <span class="text-muted">Non applicable</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if item.product.hasExpiryDate %}
                                                    <input type="date" 
                                                           name="items[{{ item.id }}][expiry_date]" 
                                                           class="form-control form-control-sm"
                                                           value="{{ item.expiryDate ? item.expiryDate|date('Y-m-d') : '' }}">
                                                {% else %}
                                                    <span class="text-muted">Non applicable</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                <input type="number" 
                                                       step="0.01"
                                                       min="0"
                                                       name="items[{{ item.id }}][unit_price]" 
                                                       class="form-control form-control-sm text-center"
                                                       value="{{ item.unitPrice }}"
                                                       required>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label for="notes" class="form-label">
                                        <i class="fas fa-sticky-note me-2"></i>
                                        Notes sur la réception (optionnel)
                                    </label>
                                    <textarea name="notes" 
                                              id="notes" 
                                              class="form-control" 
                                              rows="3"
                                              placeholder="Ajoutez des notes ou observations concernant cette réception..."></textarea>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <strong>Attention :</strong> Cette action est irréversible. 
                                    Après validation, la commande sera marquée comme "Reçue" et les stocks seront mis à jour.
                                </div>
                            </div>
                            <div class="col-md-6 text-end">
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="fas fa-check-circle me-2"></i>
                                    Confirmer la réception
                                </button>
                            </div>
                        </div>
                        
                        <input type="hidden" name="_token" value="{{ csrf_token('purchase_receive_' ~ purchase.id) }}">
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('receiveForm');
    
    form.addEventListener('submit', function(e) {
        let isValid = true;
        let errorMessage = '';
        
        // Validation des champs requis
        document.querySelectorAll('input[required]').forEach(input => {
            if (!input.value.trim()) {
                isValid = false;
                input.classList.add('is-invalid');
                errorMessage = 'Tous les champs marqués d\'un * sont obligatoires';
            } else {
                input.classList.remove('is-invalid');
            }
        });
        
        // Validation des prix
        document.querySelectorAll('input[name*="unit_price"]').forEach(input => {
            const price = parseFloat(input.value);
            if (price <= 0 || isNaN(price)) {
                isValid = false;
                input.classList.add('is-invalid');
                errorMessage = 'Les prix unitaires doivent être supérieurs à 0';
            }
        });
        
        if (!isValid) {
            e.preventDefault();
            
            // Afficher un message d'erreur
            let alertDiv = document.querySelector('.alert.alert-danger');
            if (!alertDiv) {
                alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-danger alert-dismissible fade show';
                alertDiv.innerHTML = `
                    ${errorMessage}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                form.prepend(alertDiv);
            } else {
                alertDiv.querySelector('.alert-message').textContent = errorMessage;
            }
            
            // Faire défiler vers le haut
            window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
            // Afficher un indicateur de chargement
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Traitement en cours...';
        }
    });
});
</script>

<style>
.card {
    border-radius: 12px;
    overflow: hidden;
}

.table td {
    vertical-align: middle;
}

.badge {
    font-weight: 500;
    padding: 0.5em 0.8em;
}

.form-control-sm {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
}

.is-invalid {
    border-color: #dc3545 !important;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right calc(0.375em + 0.1875rem) center;
    background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
}
</style>
{% endblock %}

{% macro generate_batch_number() %}
    LOT-{{ "now"|date('Ymd') }}-{{ random(1000, 9999) }}
{% endmacro %}