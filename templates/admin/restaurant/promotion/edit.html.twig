{% extends 'base.html.twig' %}

{% block title %}Modifier {{ promotion.name }} - HMA Market{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_admin_promotion_index') }}">Promotions</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_admin_promotion_show', {'id': promotion.id}) }}">{{ promotion.name|u.truncate(20) }}</a></li>
                    <li class="breadcrumb-item active">Modifier</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fas fa-edit me-2"></i> Modifier la promotion
            </h1>
        </div>
        <div>
            <i class="fas fa-percent fa-3x text-warning opacity-75"></i>
        </div>
    </div>

    {{ include('admin/promotion/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
</div>
{% endblock %}