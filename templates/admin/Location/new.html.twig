{# templates/admin/location/new.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Nouvel emplacement - HMA Market{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_admin_location_index') }}" class="text-decoration-none">
                            <i class="fas fa-map-marker-alt me-1"></i> Emplacements
                        </a>
                    </li>
                    <li class="breadcrumb-item active">
                        <i class="fas fa-plus-circle me-1"></i> Nouvel emplacement
                    </li>
                </ol>
            </nav>
            <h1 class="h3 mb-0">
                <i class="fas fa-plus-circle me-2 text-success"></i>
                Créer un nouvel emplacement
            </h1>
            <p class="text-muted mt-1">
                Ajoutez un nouvel emplacement physique pour organiser votre stock
            </p>
        </div>
    </div>

    {% include 'admin/location/_form.html.twig' with {
        'form': form,
        'button_label': 'Créer l\'emplacement'
    } only %}
</div>
{% endblock %}