{% extends 'base.html.twig' %}

{% block title %}Nouvelle promotion - HMA Market{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="{{ path('app_admin_promotion_index') }}" class="btn btn-outline-secondary mb-2">
                <i class="fas fa-arrow-left me-1"></i> Retour à la liste
            </a>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fas fa-plus-circle me-2"></i> Nouvelle promotion
            </h1>
            <p class="text-muted mt-2">Créez une nouvelle offre promotionnelle (réduction, solde, etc.)</p>
        </div>
        <div>
            <i class="fas fa-percent fa-3x text-primary opacity-75"></i>
        </div>
    </div>

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {{ include('admin/promotion/_form.html.twig') }}
</div>
{% endblock %}