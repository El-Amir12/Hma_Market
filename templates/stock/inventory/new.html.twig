{# templates/stock/inventory/new.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Nouvel inventaire - HMA Market{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
<style>
/* ============================================
   ÉTAPES
   ============================================ */
.steps {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    position: relative;
    padding: 0 0.5rem;
}

.step {
    text-align: center;
    flex: 1;
    position: relative;
    z-index: 1;
}

.step-circle {
    width: 40px;
    height: 40px;
    background: #e9ecef;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.4rem;
    font-weight: 700;
    color: #6c757d;
    font-size: 0.9rem;
    border: 3px solid white;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.step.active .step-circle {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    transform: scale(1.1);
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
}

.step-label {
    font-size: 0.7rem;
    color: #6c757d;
    font-weight: 500;
    line-height: 1.2;
}

.step.active .step-label {
    color: #667eea;
    font-weight: 700;
}

.steps-line {
    position: absolute;
    top: 20px;
    left: 12%;
    right: 12%;
    height: 2px;
    background: #e9ecef;
    z-index: 0;
}

/* ============================================
   FORMULAIRE
   ============================================ */
.form-card {
    background: white;
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border: 1px solid #e9ecef;
    max-width: 700px;
    margin: 0 auto;
}

.form-card-header {
    text-align: center;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid #f1f5f9;
}

.form-card-header .header-icon {
    width: 65px;
    height: 65px;
    border-radius: 16px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    margin-bottom: 1rem;
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.25);
}

.form-card-header h2 {
    font-weight: 800;
    font-size: 1.35rem;
    color: #1e293b;
    margin-bottom: 0.35rem;
}

.form-card-header p {
    color: #64748b;
    font-size: 0.88rem;
    margin: 0;
}

/* Champs du formulaire */
.form-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #334155;
    margin-bottom: 0.4rem;
}

.form-control, .form-select {
    border-radius: 10px;
    border: 2px solid #e2e8f0;
    padding: 0.65rem 0.9rem;
    font-size: 0.9rem;
    transition: all 0.2s;
}

.form-control:focus, .form-select:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.15);
}

textarea.form-control {
    min-height: 90px;
    resize: vertical;
}

/* Select2 Location */
.select2-container--bootstrap-5 .select2-selection {
    min-height: 48px !important;
    border: 2px solid #e2e8f0 !important;
    border-radius: 10px !important;
    padding: 0.4rem 0.65rem !important;
    transition: all 0.2s;
}

.select2-container--bootstrap-5.select2-container--focus .select2-selection {
    border-color: #667eea !important;
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.15) !important;
}

.select2-container--bootstrap-5 .select2-dropdown {
    border: 2px solid #667eea !important;
    border-radius: 10px !important;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    overflow: hidden;
    margin-top: 4px;
}

.select2-container--bootstrap-5 .select2-results__option--highlighted {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    color: white !important;
}

/* Boutons */
.action-buttons {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e9ecef;
    flex-wrap: wrap;
}

.btn-action {
    padding: 0.7rem 1.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 12px;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(0,0,0,0.15);
}

.btn-primary.btn-action {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border: none;
    min-width: 200px;
    justify-content: center;
}

.btn-primary.btn-action:hover {
    box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
}

/* Erreurs */
.field-error {
    color: #dc2626;
    font-size: 0.8rem;
    margin-top: 0.3rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
}

.form-error-box {
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-left: 4px solid #ef4444;
    border-radius: 10px;
    padding: 1rem 1.15rem;
    margin-bottom: 1.25rem;
    color: #991b1b;
    font-size: 0.88rem;
}

.form-error-box .error-title {
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
}

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 767.98px) {
    .container-fluid {
        padding-left: 0.75rem !important;
        padding-right: 0.75rem !important;
    }

    .steps {
        padding: 0;
        margin-bottom: 1.25rem;
    }

    .step-circle {
        width: 34px;
        height: 34px;
        font-size: 0.8rem;
        border-width: 2px;
    }

    .step-label {
        font-size: 0.62rem;
    }

    .steps-line {
        top: 17px;
    }

    .form-card {
        padding: 1.15rem;
        border-radius: 14px;
    }

    .form-card-header .header-icon {
        width: 55px;
        height: 55px;
        font-size: 1.4rem;
    }

    .form-card-header h2 {
        font-size: 1.1rem;
    }

    .form-card-header p {
        font-size: 0.8rem;
    }

    .action-buttons {
        flex-direction: column-reverse;
        align-items: stretch;
        gap: 0.5rem;
    }

    .btn-action {
        width: 100%;
        padding: 0.65rem 1rem;
        font-size: 0.88rem;
        justify-content: center;
        min-width: auto !important;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="container-fluid px-3 px-md-4 py-3">

    <!-- En-tête -->
    <div class="d-flex justify-content-between align-items-center mb-3 mb-md-4 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item small">
                        <a href="{{ path('app_dashboard') }}" class="text-decoration-none">
                            <i class="fas fa-tachometer-alt me-1"></i>
                            <span class="d-none d-sm-inline">Tableau de bord</span>
                        </a>
                    </li>
                    <li class="breadcrumb-item small">
                        <a href="{{ path('app_stock_inventory_index') }}" class="text-decoration-none">
                            <i class="fas fa-clipboard-list me-1"></i>
                            <span class="d-none d-sm-inline">Inventaires</span>
                        </a>
                    </li>
                    <li class="breadcrumb-item active small">Nouveau</li>
                </ol>
            </nav>
            <h1 class="h4 h3-md mb-0 fw-bold">
                <i class="fas fa-plus-circle text-primary me-2"></i>
                Nouvel inventaire
            </h1>
        </div>
    </div>

    <!-- Étapes -->
    <div class="steps">
        <div class="step active">
            <div class="step-circle">1</div>
            <div class="step-label">Création</div>
        </div>
        <div class="step">
            <div class="step-circle">2</div>
            <div class="step-label">Ajout</div>
        </div>
        <div class="step">
            <div class="step-circle">3</div>
            <div class="step-label">Comptage</div>
        </div>
        <div class="step">
            <div class="step-circle">4</div>
            <div class="step-label">Validation</div>
        </div>
        <div class="steps-line"></div>
    </div>

    <!-- Formulaire -->
    <div class="form-card">

        <div class="form-card-header">
            <div class="header-icon">
                <i class="fas fa-clipboard-list"></i>
            </div>
            <h2>Créer un nouvel inventaire</h2>
            <p>Renseignez les informations de base pour démarrer</p>
        </div>

        <!-- Erreurs globales -->
        {% if form.vars.errors|length > 0 %}
            <div class="form-error-box">
                <div class="error-title">
                    <i class="fas fa-exclamation-triangle"></i>
                    Le formulaire contient des erreurs
                </div>
                <ul class="mb-0 ps-3">
                    {% for error in form.vars.errors %}
                        <li>{{ error.message }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'newInventoryForm'}}) }}

            <div class="mb-3">
                {{ form_label(form.inventory_date, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.inventory_date, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.inventory_date) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.location, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.location, {'attr': {'class': 'form-select select2-location'}}) }}
                {{ form_errors(form.location) }}
                <small class="text-muted d-block mt-2">
                    <i class="fas fa-info-circle me-1"></i>
                    Laissez vide pour inventorier tous les emplacements
                </small>
            </div>

            <div class="mb-3">
                {{ form_label(form.notes, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.notes, {'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Instructions particulières, remarques...'}}) }}
                {{ form_errors(form.notes) }}
            </div>

            <div class="action-buttons">
                <a href="{{ path('app_stock_inventory_index') }}" class="btn btn-outline-secondary btn-action">
                    <i class="fas fa-times me-2"></i>Annuler
                </a>
                <button type="submit" class="btn btn-primary btn-action" id="submitBtn">
                    <i class="fas fa-arrow-right me-2"></i>Continuer
                </button>
            </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/fr.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const locationSelect = document.querySelector('.select2-location');
    if (locationSelect && typeof $ !== 'undefined' && $.fn.select2) {
        $(locationSelect).select2({
            theme: 'bootstrap-5',
            language: 'fr',
            placeholder: '-- Tous les emplacements --',
            allowClear: true,
            width: '100%'
        });
    }

    // Feedback visuel au submit
    const form = document.getElementById('newInventoryForm');
    const submitBtn = document.getElementById('submitBtn');

    form?.addEventListener('submit', function() {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Création...';
    });
});
</script>
{% endblock %}