{# templates/stock/inventory/validate.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Validation - {{ inventory.inventoryNumber }} - HMA Market{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ============================================
   ÉTAPES
   ============================================ */
.steps {
    display: flex;
    justify-content: space-between;
    margin-bottom: 2rem;
    position: relative;
    padding: 0 1rem;
}

.step {
    text-align: center;
    flex: 1;
    position: relative;
    z-index: 1;
}

.step-circle {
    width: 44px;
    height: 44px;
    background: #e9ecef;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.5rem;
    font-weight: 700;
    color: #6c757d;
    font-size: 1rem;
    border: 3px solid white;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.step.active .step-circle {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    transform: scale(1.1);
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
}

.step.completed .step-circle {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
}

.step-label {
    font-size: 0.75rem;
    color: #6c757d;
    font-weight: 500;
}

.step.active .step-label {
    color: #667eea;
    font-weight: 700;
}

.step.completed .step-label {
    color: #10b981;
    font-weight: 600;
}

.steps-line {
    position: absolute;
    top: 22px;
    left: 10%;
    right: 10%;
    height: 3px;
    background: #e9ecef;
    z-index: 0;
}

/* ============================================
   CARTE INVENTAIRE
   ============================================ */
.inventory-info {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-radius: 20px;
    padding: 1.5rem 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
    position: relative;
    overflow: hidden;
}

.inventory-info::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -10%;
    width: 200px;
    height: 200px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
}

.inventory-info h3 {
    font-weight: 800;
    margin-bottom: 0.5rem;
    font-size: 1.3rem;
    position: relative;
    z-index: 1;
}

.inventory-info .badge {
    background: rgba(255, 255, 255, 0.25) !important;
    color: white !important;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    border-radius: 2rem;
    font-size: 0.8rem;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.3);
    position: relative;
    z-index: 1;
}

/* ============================================
   CARTES STATISTIQUES
   ============================================ */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.stat-card {
    background: white;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border: 1px solid #e9ecef;
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: all 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.08);
}

.stat-icon {
    width: 50px;
    height: 50px;
    min-width: 50px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    color: white;
}

.stat-icon.primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.stat-icon.success {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
}

.stat-icon.warning {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
}

.stat-icon.danger {
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
}

.stat-content {
    flex: 1;
    min-width: 0;
}

.stat-value {
    font-size: 1.75rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1;
    margin-bottom: 0.25rem;
}

.stat-label {
    font-size: 0.75rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
}

/* ============================================
   TABLEAU DES ÉCARTS
   ============================================ */
.differences-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border: 1px solid #e9ecef;
    margin-bottom: 1.5rem;
}

.differences-header {
    background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #fde68a;
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.differences-header i {
    font-size: 1.5rem;
    color: #d97706;
}

.differences-header h5 {
    margin: 0;
    font-weight: 700;
    color: #92400e;
    font-size: 1rem;
}

.differences-table {
    margin: 0;
    width: 100%;
}

.differences-table thead {
    background: #f8fafc;
}

.differences-table thead th {
    font-weight: 700;
    color: #475569;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 1rem;
    border-bottom: 2px solid #e2e8f0;
}

.differences-table tbody td {
    padding: 1rem;
    vertical-align: middle;
    border-bottom: 1px solid #f1f5f9;
}

.product-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.product-avatar {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: 10px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
}

.product-name {
    font-weight: 600;
    color: #1e293b;
    font-size: 0.9rem;
}

.quantity-badge {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.85rem;
}

.quantity-badge.expected {
    background: #eef2ff;
    color: #4f46e5;
}

.quantity-badge.actual {
    background: #f0fdf4;
    color: #16a34a;
}

.difference-badge {
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: 10px;
    font-size: 0.9rem;
    display: inline-block;
    min-width: 70px;
    text-align: center;
}

.difference-badge.positive {
    background: #dcfce7;
    color: #16a34a;
    border: 2px solid #86efac;
}

.difference-badge.negative {
    background: #fee2e2;
    color: #dc2626;
    border: 2px solid #fca5a5;
}

/* ============================================
   ÉTAT SANS ÉCART
   ============================================ */
.no-difference-card {
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    border: 2px solid #86efac;
    border-radius: 16px;
    padding: 3rem 2rem;
    text-align: center;
    margin-bottom: 1.5rem;
}

.no-difference-card i {
    font-size: 4rem;
    color: #16a34a;
    margin-bottom: 1rem;
}

.no-difference-card h4 {
    color: #14532d;
    font-weight: 800;
    margin-bottom: 0.5rem;
}

.no-difference-card p {
    color: #166534;
    margin: 0;
    font-size: 0.95rem;
}

/* ============================================
   BOUTONS D'ACTION
   ============================================ */
.action-buttons {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
}

.btn-action {
    padding: 0.7rem 1.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 12px;
    transition: all 0.3s ease;
    white-space: nowrap;
}

.btn-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(0,0,0,0.15);
}

.btn-success.btn-action {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    border: none;
    min-width: 220px;
}

/* ============================================
   MODAL DE CONFIRMATION
   ============================================ */
.confirmation-modal .modal-content {
    border: none;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}

.confirmation-modal .modal-header {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
    border: none;
    padding: 1.25rem 1.5rem;
}

.confirmation-modal .modal-header.warning-header {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
}

.confirmation-modal .modal-header .modal-title {
    font-weight: 700;
    font-size: 1rem;
    color: white;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.confirmation-modal .modal-header .btn-close {
    filter: brightness(0) invert(1);
    opacity: 0.9;
}

.confirmation-modal .modal-body {
    padding: 1.5rem;
}

/* Résumé dans le modal */
.confirm-summary {
    background: #f8fafc;
    border-radius: 12px;
    padding: 1rem;
    border: 1px solid #e2e8f0;
    margin-bottom: 1rem;
}

.confirm-summary .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 0.5rem 0;
    gap: 1rem;
    border-bottom: 1px dashed #e2e8f0;
}

.confirm-summary .summary-row:last-child {
    border-bottom: none;
}

.confirm-summary .summary-label {
    color: #64748b;
    font-size: 0.85rem;
    font-weight: 500;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.35rem;
}

.confirm-summary .summary-value {
    font-weight: 700;
    color: #1e293b;
    font-size: 0.9rem;
    text-align: right;
    word-break: break-word;
}

/* Statistiques dans le modal */
.modal-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-top: 1rem;
}

.modal-stat {
    text-align: center;
    padding: 0.85rem 0.5rem;
    background: white;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
}

.modal-stat .stat-value {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.25rem;
}

.modal-stat .stat-label {
    font-size: 0.7rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
}

.modal-stat.primary .stat-value { color: #667eea; }
.modal-stat.success .stat-value { color: #10b981; }
.modal-stat.warning .stat-value { color: #f59e0b; }
.modal-stat.danger .stat-value { color: #dc2626; }

/* Alertes modal */
.alert-modal-warning {
    background: #fef3c7;
    border-left: 4px solid #f59e0b;
    border-radius: 10px;
    padding: 0.85rem 1rem;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    color: #78350f;
    font-size: 0.85rem;
    margin-top: 1rem;
}

.alert-modal-warning i {
    color: #d97706;
    font-size: 1.1rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
}

.alert-modal-success {
    background: #d1fae5;
    border-left: 4px solid #10b981;
    border-radius: 10px;
    padding: 0.85rem 1rem;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    color: #065f46;
    font-size: 0.85rem;
    margin-top: 1rem;
}

.alert-modal-success i {
    color: #059669;
    font-size: 1.1rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
}

.confirmation-modal .modal-footer {
    border: none;
    padding: 1rem 1.5rem 1.25rem;
    gap: 0.5rem;
    background: #f8fafc;
}

.confirmation-modal .modal-footer .btn {
    border-radius: 10px;
    font-weight: 600;
    padding: 0.6rem 1.5rem;
}

/* ============================================
   RESPONSIVE MOBILE
   ============================================ */
@media (max-width: 767.98px) {
    .container-fluid {
        padding-left: 0.75rem !important;
        padding-right: 0.75rem !important;
    }

    .steps {
        margin-bottom: 1.5rem;
    }

    .step-circle {
        width: 34px;
        height: 34px;
        font-size: 0.8rem;
    }

    .step-label {
        font-size: 0.6rem;
    }

    .steps-line {
        top: 17px;
    }

    .inventory-info {
        padding: 1.25rem;
        border-radius: 16px;
    }

    .inventory-info h3 {
        font-size: 1.1rem;
    }

    .inventory-info .badge {
        font-size: 0.7rem;
        padding: 0.3rem 0.7rem;
    }

    .stats-grid {
        grid-template-columns: 1fr;
        gap: 0.75rem;
    }

    .stat-card {
        padding: 1rem;
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        font-size: 1rem;
    }

    .stat-value {
        font-size: 1.4rem;
    }

    .differences-table thead {
        display: none;
    }

    .differences-table tbody tr {
        display: block;
        background: white;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        margin: 0.75rem;
        padding: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .differences-table tbody td {
        display: block;
        padding: 0.4rem 0 !important;
        border: none;
    }

    .differences-table tbody td::before {
        content: attr(data-label);
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        color: #94a3b8;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 0.25rem;
    }

    .product-info {
        justify-content: flex-start;
    }

    .action-buttons {
        flex-direction: column-reverse;
        align-items: stretch;
    }

    .btn-action {
        width: 100%;
        padding: 0.65rem 1rem;
        font-size: 0.9rem;
        min-width: auto !important;
    }

    .confirmation-modal .modal-footer {
        flex-direction: column-reverse;
    }

    .confirmation-modal .modal-footer .btn {
        width: 100%;
    }

    .modal-stats {
        grid-template-columns: 1fr;
    }

    .confirm-summary .summary-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.25rem;
    }

    .confirm-summary .summary-value {
        text-align: left;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">
    <!-- En-tête -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_stock_inventory_index') }}" class="text-decoration-none">
                            <i class="fas fa-clipboard-list me-1"></i> Inventaires
                        </a>
                    </li>
                    <li class="breadcrumb-item active">Validation</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 fw-bold">
                <i class="fas fa-check-circle text-success me-2"></i>
                Validation - {{ inventory.inventoryNumber }}
            </h1>
        </div>
    </div>

    <!-- Étapes -->
    <div class="steps">
        <div class="step completed">
            <div class="step-circle"><i class="fas fa-check"></i></div>
            <div class="step-label">Création</div>
        </div>
        <div class="step completed">
            <div class="step-circle"><i class="fas fa-check"></i></div>
            <div class="step-label">Ajout produits</div>
        </div>
        <div class="step completed">
            <div class="step-circle"><i class="fas fa-check"></i></div>
            <div class="step-label">Saisie comptage</div>
        </div>
        <div class="step active">
            <div class="step-circle">4</div>
            <div class="step-label">Validation</div>
        </div>
        <div class="steps-line"></div>
    </div>

    <!-- Info inventaire -->
    <div class="inventory-info">
        <h3>
            <i class="fas fa-clipboard-list me-2"></i>
            {{ inventory.inventoryNumber }}
        </h3>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <span class="badge">
                <i class="fas fa-calendar me-1"></i>
                {{ inventory.inventoryDate|date('d/m/Y') }}
            </span>
            {% if inventory.location %}
                <span class="badge">
                    <i class="fas fa-map-marker-alt me-1"></i>
                    {{ inventory.location.name }}
                </span>
            {% endif %}
            <span class="badge">
                <i class="fas fa-info-circle me-1"></i>
                {{ inventory.statusLabel }}
            </span>
        </div>
    </div>

    <!-- Statistiques -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon primary">
                <i class="fas fa-boxes"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">{{ totalItems }}</div>
                <div class="stat-label">Produits total</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon {{ differenceCount > 0 ? 'warning' : 'success' }}">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="stat-content">
                <div class="stat-value">{{ differenceCount }}</div>
                <div class="stat-label">Produits avec écart</div>
            </div>
        </div>
    </div>

    <!-- Écarts -->
    {% if differences|length > 0 %}
        <div class="differences-card">
            <div class="differences-header">
                <i class="fas fa-exclamation-triangle"></i>
                <h5>
                    Écarts détectés ({{ differences|length }})
                </h5>
            </div>
            <table class="differences-table">
                <thead>
                    <tr>
                        <th>Produit</th>
                        <th class="text-center">Attendu</th>
                        <th class="text-center">Compté</th>
                        <th class="text-center">Écart</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in differences %}
                    <tr>
                        <td data-label="Produit">
                            <div class="product-info">
                                <div class="product-avatar">
                                    {{ item.product.name|first|upper }}
                                </div>
                                <div>
                                    <div class="product-name">{{ item.product.name }}</div>
                                    {% if item.product.barcode %}
                                        <div class="product-barcode" style="font-size: 0.75rem; color: #94a3b8; font-family: 'Courier New', monospace;">
                                            {{ item.product.barcode }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td data-label="Attendu" class="text-center">
                            <span class="quantity-badge expected">{{ item.expectedQuantity }}</span>
                        </td>
                        <td data-label="Compté" class="text-center">
                            <span class="quantity-badge actual">{{ item.actualQuantity }}</span>
                        </td>
                        <td data-label="Écart" class="text-center">
                            <span class="difference-badge {{ item.difference > 0 ? 'positive' : 'negative' }}">
                                {% if item.difference > 0 %}+{% endif %}{{ item.difference }}
                            </span>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="no-difference-card">
            <i class="fas fa-check-circle"></i>
            <h4>Aucun écart détecté</h4>
            <p>Le stock physique correspond exactement au stock système.</p>
        </div>
    {% endif %}

    <!-- Boutons d'action -->
    <form method="post" id="validateInventoryForm">
        <div class="action-buttons">
            <a href="{{ path('app_stock_inventory_count', {'id': inventory.id}) }}" class="btn btn-outline-secondary btn-action">
                <i class="fas fa-arrow-left me-2"></i>Retour au comptage
            </a>
            {# ✅ Bouton type="button" : ouvre le modal #}
            <button type="button" class="btn btn-success btn-action" id="openValidateInventoryModalBtn">
                <i class="fas fa-check-circle me-2"></i>
                Valider l'inventaire
            </button>
        </div>
    </form>
</div>

<!-- ==========================================
     MODAL DE CONFIRMATION
========================================== -->
<div class="modal fade confirmation-modal" id="confirmValidateInventoryModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header {% if differenceCount > 0 %}warning-header{% endif %}">
                <h5 class="modal-title">
                    <i class="fas {% if differenceCount > 0 %}fa-exclamation-triangle{% else %}fa-check-circle{% endif %}"></i>
                    {% if differenceCount > 0 %}
                        Confirmer la validation avec écarts
                    {% else %}
                        Confirmer la validation
                    {% endif %}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3 small text-muted">
                    Vérifiez le récapitulatif avant de valider définitivement :
                </p>

                <!-- Résumé -->
                <div class="confirm-summary">
                    <div class="summary-row">
                        <span class="summary-label">
                            <i class="fas fa-clipboard-list text-primary"></i> N° inventaire
                        </span>
                        <span class="summary-value">{{ inventory.inventoryNumber }}</span>
                    </div>
                    <div class="summary-row">
                        <span class="summary-label">
                            <i class="fas fa-calendar text-primary"></i> Date
                        </span>
                        <span class="summary-value">{{ inventory.inventoryDate|date('d/m/Y') }}</span>
                    </div>
                    {% if inventory.location %}
                    <div class="summary-row">
                        <span class="summary-label">
                            <i class="fas fa-map-marker-alt text-primary"></i> Emplacement
                        </span>
                        <span class="summary-value">{{ inventory.location.name }}</span>
                    </div>
                    {% endif %}
                </div>

                <!-- Statistiques -->
                <div class="modal-stats">
                    <div class="modal-stat primary">
                        <div class="stat-value">{{ totalItems }}</div>
                        <div class="stat-label">Produits total</div>
                    </div>
                    <div class="modal-stat {% if differenceCount > 0 %}warning{% else %}success{% endif %}">
                        <div class="stat-value">{{ differenceCount }}</div>
                        <div class="stat-label">Produits avec écart</div>
                    </div>
                </div>

                <!-- Alerte adaptative -->
                {% if differenceCount > 0 %}
                    <div class="alert-modal-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <div>
                            <strong>{{ differenceCount }} ajustement(s) vont être appliqué(s)</strong>
                            <small class="d-block mt-1">
                                Le stock sera automatiquement corrigé pour correspondre aux quantités comptées.
                                Chaque écart génèrera un mouvement de stock <strong>adjustment_in</strong> ou <strong>adjustment_out</strong>.
                            </small>
                        </div>
                    </div>
                {% else %}
                    <div class="alert-modal-success">
                        <i class="fas fa-check-circle"></i>
                        <div>
                            <strong>Aucun écart constaté</strong>
                            <small class="d-block mt-1">
                                Le stock physique correspond exactement au stock système.
                                L'inventaire sera simplement marqué comme terminé.
                            </small>
                        </div>
                    </div>
                {% endif %}

                <div class="alert-modal-warning mt-3">
                    <i class="fas fa-lock"></i>
                    <div>
                        <strong>Action irréversible</strong>
                        <small class="d-block mt-1">
                            Une fois validé, l'inventaire ne pourra plus être modifié ni annulé.
                        </small>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-arrow-left me-1"></i> Retour
                </button>
                <button type="button" class="btn btn-success" id="confirmValidateInventoryBtn">
                    <i class="fas fa-check-circle me-1"></i> Confirmer la validation
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {

    const modalEl = document.getElementById('confirmValidateInventoryModal');
    const modal = new bootstrap.Modal(modalEl);
    const openBtn = document.getElementById('openValidateInventoryModalBtn');
    const confirmBtn = document.getElementById('confirmValidateInventoryBtn');
    const form = document.getElementById('validateInventoryForm');

    let isConfirmed = false;

    // ✅ Ouvrir le modal
    openBtn?.addEventListener('click', function() {
        modal.show();
    });

    // ✅ Confirmer la validation
    confirmBtn?.addEventListener('click', function() {
        isConfirmed = true;
        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Validation...';
        modal.hide();

        setTimeout(() => {
            form.submit();
        }, 200);
    });

    // ✅ Restaurer le bouton si le modal est fermé sans confirmer
    modalEl?.addEventListener('hidden.bs.modal', function() {
        if (!isConfirmed) {
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = '<i class="fas fa-check-circle me-1"></i> Confirmer la validation';
        }
    });
});
</script>
{% endblock %}