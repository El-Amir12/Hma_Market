FROM dunglas/frankenphp:php8.3

# Copier le binaire Composer depuis l'image officielle Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Installer les extensions PHP nécessaires
# gd est requis par composer.json ; ajoutez/retirez selon vos besoins
RUN install-php-extensions pdo_pgsql intl opcache gd zip exif

WORKDIR /app

# Copier les fichiers de dépendances pour profiter du cache Docker
COPY composer.json composer.lock symfony.lock ./

# Installer les dépendances de production
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist

# Copier le reste de l'application
COPY . .

# Générer l'autoloader optimisé et préchauffer le cache
RUN composer dump-autoload --optimize --no-dev \
    && php bin/console cache:clear --env=prod --no-debug \
    && php bin/console cache:warmup --env=prod --no-debug

EXPOSE 80

CMD ["frankenphp", "php-server", "--root", "public/", "--listen", ":${PORT:-80}"]