# Dockerfile.vercel
FROM dunglas/frankenphp:1-php8.3

# Installer les extensions PHP nécessaires + Composer
RUN install-php-extensions \
    pdo_pgsql \
    pdo_mysql \
    intl \
    opcache \
    zip \
    apcu \
    gd \
    mbstring \
    @composer

# Définir le répertoire de travail
WORKDIR /app

# Copier les fichiers de dépendances en premier pour profiter du cache Docker
COPY composer.json composer.lock symfony.lock ./

# Installer les dépendances de production sans les scripts
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-progress --no-interaction

# Copier le reste de l'application
COPY . .

# Optimiser l'autoloader
RUN composer dump-autoload --optimize --classmap-authoritative --no-dev

# Créer les dossiers var et s'assurer qu'ils sont accessibles en écriture
RUN mkdir -p var/cache var/log && chmod -R 775 var

# ⚠️ Le cache Symfony NE DOIT PAS être généré ici (cache:clear / cache:warmup).
# Il sera généré automatiquement au premier démarrage du conteneur,
# quand toutes les variables d'environnement de Vercel seront disponibles
# (APP_SECRET, DATABASE_URL, etc.), évitant tout échec au build.

# Exposer le port
EXPOSE 80